{
  "name": "shift-ops",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/copy-ocr-assets.mjs",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "start:local": "npm run build && wrangler d1 migrations apply DB --local && wrangler dev --port 8787",
    "test:e2e": "playwright test --trace off",
    "deploy": "npm run build && wrangler d1 migrations apply DB --remote && wrangler deploy"
  },
  "dependencies": {
    "@tesseract.js-data/ara": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "exceljs": "^4.4.0",
    "fflate": "^0.8.3",
    "heic2any": "^0.0.4",
    "hono": "^4.13.20",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261121.1",
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "5.9",
    "vite": "^5.4.21",
    "vitest": "^2.1.9",
    "wrangler": "^4.166.0"
  }
}
